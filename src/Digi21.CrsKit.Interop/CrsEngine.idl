import "CrsInfo.idl";
import "CrsDetails.idl";
import "CoordinateOperationInfo.idl";
import "Transformation.idl";

namespace Digi21.CrsKit.Interop
{
    // Unit of the first axis of a coordinate reference system, returned by CrsEngine.GetFirstAxisUnit.
    struct CrsUnit
    {
        String Name;              // crskit name of the unit, for example "metre", "US survey foot" or "degree"
        Boolean IsAngular;        // true if the first axis uses an angular unit, false if it uses a linear unit
        Double MetresPerUnit;     // 0 when IsAngular is true
        Double RadiansPerUnit;    // 0 when IsAngular is false
    };

    // Direction of an axis of a coordinate reference system, returned by CrsEngine.GetFirstAxisOrientation. The values are those of
    // crskit's AxisOrientationEnum.
    enum AxisOrientation
    {
        Other = 0,
        North = 1,
        South = 2,
        East = 3,
        West = 4,
        Up = 5,      // a height: coordinate values increase in the upward direction
        Down = 6,    // a depth: coordinate values increase in the downward direction
    };

    // Process-wide entry point to the CrsKit library. Call Initialize once, with the path of the SQLite database of the
    // EPSG (European Petroleum Survey Group) Geodetic Parameter Dataset and the directory of the grid files, before
    // requesting coordinate reference system (CRS) definitions or creating transformations; IsInitialized and
    // GetEpsgVersion can be queried before initialization.
    // On failure, GetEpsgVersion returns an empty string; GetCatalogueAxisNamesLabel, which requires initialization,
    // returns an empty string if no axis name can be obtained; GetDetails returns an empty string for each text field it
    // cannot read and 0 if it cannot read the axis count; GetCandidateOperations ignores a failure to create a
    // transformation after CrsKit has supplied the candidate operations to the callback that GetCandidateOperations uses;
    // after initialization, IsValidWkt, AreEquivalent and IsHorizontalComponentLocal return false, GetEpsgCode returns 0
    // and GetWktFromGeoKeys returns an empty string; in all other failure cases, CrsEngine members report failures as
    // exceptions in the caller's language.
    [default_interface]
    runtimeclass CrsEngine
    {
        static void Initialize(String epsgDatabaseFilePath, String gridFilesDirectoryPath);
        static Boolean IsInitialized{ get; };

        // EPSG Geodetic Parameter Dataset version of the active database (e.g. "12.057"); "" if unknown.
        static String GetEpsgVersion();

        // Every CRS of the given kind in the EPSG catalogue, as {code, name, kind}.
        // Valid kinds: "projected", "geographic 2D", "geographic 3D", "compound",
        // "vertical", "geocentric".
        static Windows.Foundation.Collections.IVector<CrsInfo> EnumerateCoordinateSystems(String kind);

        static String GetName(Int32 code);
        static String GetAreaOfUse(Int32 code);
        static String GetWkt(Int32 code);

        // CRS name, kind, axis count, area of use, datum name and origin, prime meridian name and ellipsoid name.
        static CrsDetails GetDetails(Int32 code);
        // WKT of a CRS with a chosen axis order (Default keeps the EPSG definition). A system with fewer than two axes, such as
        // a vertical system, keeps its catalogue definition for every order.
        static String GetWktWithAxisOrder(Int32 code, AxisOrder order);
        // Joins with "-" the non-empty names of the first two axes of a CRS, in catalogue order, e.g. "Lat-Long" or "E-N";
        // for a one-dimensional CRS, returns the name of its axis. Omits an axis whose name cannot be read. Returns an empty
        // string if neither axis has a name or if reading the dimension of the CRS fails.
        static String GetCatalogueAxisNamesLabel(Int32 code);
        // WKT of the compound CRS formed by a horizontal and a vertical CRS.
        static String GetCompoundWkt(Int32 horizontalCode, Int32 verticalCode);
        // Validate a raw WKT (manual entry / .prj import) and return its CRS name; throws if invalid.
        static String GetCrsNameFromWkt(String wkt);
        // Human-readable axes and their units for a CRS given by WKT, e.g.
        // "Easting (metre), Northing (metre)" or "Latitude (degree), Longitude (degree)".
        static String DescribeAxes(String wkt);

        static Transformation CreateTransformation(Int32 sourceCode, Int32 targetCode);
        static Transformation CreateTransformationFromWkt(String sourceWkt, String targetWkt);

        // Returns the candidate EPSG operations that CrsKit passes to its selectOperation callback, which CrsKit invokes when
        // more than one operation applies, in the order CrsKit passes them. Returns an empty view if CrsKit builds the
        // transformation without invoking the callback.
        static Windows.Foundation.Collections.IVectorView<CoordinateOperationInfo> GetCandidateOperations(
            String sourceWkt, String targetWkt);
        // Creates a transformation from sourceWkt to targetWkt. If CrsKit invokes its selectOperation callback because more
        // than one operation applies, the callback returns operationCode, for example a code from GetCandidateOperations.
        static Transformation CreateTransformationFromWktWithOperation(
            String sourceWkt, String targetWkt, Int32 operationCode);

        // Returns true if wkt is one complete WKT element, NAME[...] with balanced brackets and quotes and nothing after it,
        // that crskit parses into a coordinate reference system. The text check runs before parsing because crskit's
        // parser can fail with an access violation on some truncated texts.
        static Boolean IsValidWkt(String wkt);
        // Returns true if both WKT define the same datum, prime meridian, projection with its parameters, and units. Names,
        // authority codes and axis order are not compared.
        static Boolean AreEquivalent(String firstWkt, String secondWkt);
        // Returns the WKT of the horizontal component of wkt, or the WKT serialized from the parsed system when it is
        // horizontal; returns an empty string for a vertical system.
        static String GetHorizontalWkt(String wkt);
        // Returns the WKT of the vertical component of wkt, or an empty string if the system has no vertical component.
        static String GetVerticalWkt(String wkt);
        // Returns true if the horizontal component of wkt is a local coordinate system.
        static Boolean IsHorizontalComponentLocal(String wkt);
        // Returns the WKT of the compound local system that represents an unknown coordinate reference system.
        static String GetUnknownLocalWkt();
        // Returns the EPSG code of wkt, or 0 if the WKT has no EPSG authority or crskit cannot parse it.
        static Int32 GetEpsgCode(String wkt);
        // Returns the WKT of the system that the GeoTIFF keys GTModelTypeGeoKey, ProjectedCSTypeGeoKey,
        // GeographicTypeGeoKey and ProjectionGeoKey declare, as GeoTIFF files and the GeoTIFF records of LAS files store
        // them. A geographic system has the longitude axis first. Returns an empty string if modelType is neither 1 nor 2,
        // if modelType is 1 and both projectedCrsCode and projectionCode are 32767 (user-defined), or if crskit cannot build
        // the system.
        static String GetWktFromGeoKeys(UInt16 modelType, UInt16 projectedCrsCode, UInt16 geographicCrsCode, UInt16 projectionCode);
        // Returns the unit of the first axis of the coordinate reference system parsed from wkt.
        static CrsUnit GetFirstAxisUnit(String wkt);
        // Returns the direction of the first axis of the coordinate reference system parsed from wkt. For the vertical component
        // of a compound system, pass the WKT that GetVerticalWkt returns.
        static AxisOrientation GetFirstAxisOrientation(String wkt);
        // Creates a transformation whose input is {east, north}, or {longitude, latitude}, in the horizontal component of
        // sourceWkt, whatever axis order the system declares, and whose output is {latitude, longitude} in WGS 84
        // (EPSG:4326), in degrees.
        static Transformation CreateEastNorthToWgs84LatitudeLongitude(String sourceWkt);
    }
}
